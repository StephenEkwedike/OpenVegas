  "captions": [
    {"start":0,"end":3.5,"text":"At the Bureau of Alternate Tuesdays, every universe needs an appointment."},
    {"start":3.5,"end":7,"text":"This visitor brought three futures. All were double-booked."},
    {"start":7,"end":10.5,"text":"CLERK: Which future did you reserve?"},
    {"start":10.5,"end":14,"text":"VISITOR: The one where this takes less time."},
    {"start":14,"end":17.5,"text":"CLERK: Excellent. Please take a number."},
    {"start":17.5,"end":21,"text":"VISITOR: Is infinity before or after lunch?"},
    {"start":21,"end":24.5,"text":"A minor paperwork storm. Entirely within the forecast."},
    {"start":24.5,"end":28,"text":"CLERK: Approved. We found you a better universe."},
    {"start":28,"end":31.5,"text":"VISITOR: This is the same office."},
    {"start":31.5,"end":35,"text":"CLERK: Yes, but this one has a plant."}
