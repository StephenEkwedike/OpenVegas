#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$ROOT/.venv/bin/python" ]; then
    printf '%s\n' 'Local Python environment missing. See docs/LOCAL_DEVELOPMENT.md for first-time setup.' >&2
    exit 1
fi
exec "$ROOT/.venv/bin/python" "$ROOT/scripts/local_stack.py" "$@"
