# Deny by default, including untracked notes and all local environment files.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!requirements.lock
!README.md
!openvegas/
!openvegas/**/
!openvegas/**/*.py
!server/
!server/**/
!server/**/*.py
!ui/
!ui/**/
!ui/**/*.html
!ui/**/*.css
!ui/**/*.js
!ui/**/*.json
!ui/**/*.png
!ui/**/*.jpg
!ui/**/*.jpeg
!ui/**/*.svg
!ui/**/*.ico
!ui/**/*.woff
!ui/**/*.woff2
!supabase/
!supabase/migrations/
!supabase/migrations/*.sql
!scripts/
!scripts/*.sh
!scripts/*.py

# Keep sensitive files excluded even inside an allowed source directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/__pycache__/
**/node_modules/
**/.git/
