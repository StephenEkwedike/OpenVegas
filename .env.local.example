# Copy to .env.local only if that file does not exist. Never overwrite .env.
# Use a dedicated development Supabase project or the local stack in dev/.
OPENVEGAS_RUNTIME_ENV=development
OPENVEGAS_DOTENV_OVERRIDE=0
OPENVEGAS_TEST_MODE=0
OPENVEGAS_DB_FAIL_OPEN=0
OPENVEGAS_DB_CONNECT_TIMEOUT_SEC=5
OPENVEGAS_DB_STATEMENT_CACHE_SIZE=0
OPENVEGAS_REDIS_REQUIRED=1
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
REDIS_URL=redis://127.0.0.1:16379/0
OPENVEGAS_BACKEND_URL=http://127.0.0.1:8000
OPENVEGAS_API_URL=http://127.0.0.1:8000
OPENVEGAS_COOKIE_SECURE=0
OPENVEGAS_TRUSTED_PROXY_HEADERS=0
OPENVEGAS_QR_AUTO_INSTALL=0
OPENVEGAS_CONTEXT_ENABLED=1
OPENVEGAS_ENABLE_VISION=1
OPENVEGAS_ENABLE_HOST_IDE_BRIDGE=0
OPENVEGAS_BILLING_PROVIDER=stripe
# Test mode credentials only. Leave blank until testing payments deliberately.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://127.0.0.1:8000/ui/checkout-success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://127.0.0.1:8000/ui/checkout-cancel
V_PER_USD=100
STARTER_GRANT_V=100
CASINO_HUMAN_ENABLED=1
INFERENCE_ENABLED=1
AGENT_RUNTIME_ENABLED=1
STORE_ENABLED=1
MINT_AUDIT_ENABLED=1
OPENVEGAS_ENABLE_FILES=1
OPENVEGAS_ENABLE_SPEECH_TO_TEXT=1
# Opt-in only after separate isolation/cost/lifecycle verification.
OPENVEGAS_ENABLE_CODE_EXEC=0
OPENVEGAS_ENABLE_MCP=0
OPENVEGAS_ENABLE_REALTIME_VOICE=0
OPENVEGAS_ENABLE_IMAGE_GEN=0
OPENAI_API_KEY=
# Optional server-managed customer model routing, never a customer/BYOK key.
OPENROUTER_API_KEY=
# Exact model/price/access reviews are required before enabling catalog entries.
OPENVEGAS_MODEL_REVIEWS_JSON={}
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
