# Variable names for the approved Railway service. No secrets belong in Git.
# Configure values in Railway Variables, never copy a local .env into the image.
OPENVEGAS_RUNTIME_ENV=production
OPENVEGAS_DOTENV_OVERRIDE=0
OPENVEGAS_TEST_MODE=0
OPENVEGAS_DB_FAIL_OPEN=0
OPENVEGAS_DB_CONNECT_TIMEOUT_SEC=20
OPENVEGAS_DB_STATEMENT_CACHE_SIZE=0
OPENVEGAS_REDIS_REQUIRED=1
DATABASE_URL=
SUPABASE_URL=
# Same public HTTPS Supabase URL (never an internal container hostname).
SUPABASE_PUBLIC_URL=
SUPABASE_ANON_KEY=
# Optional for asymmetric Supabase JWTs; required for offline HS256 verification.
SUPABASE_JWT_SECRET=
REDIS_URL=
OPENVEGAS_BACKEND_URL=https://app.openvegas.ai
OPENVEGAS_API_URL=https://app.openvegas.ai
OPENVEGAS_COOKIE_SECURE=1
OPENVEGAS_TRUSTED_PROXY_HEADERS=1
OPENVEGAS_QR_AUTO_INSTALL=0
OPENVEGAS_CONTEXT_ENABLED=1
OPENVEGAS_ENABLE_VISION=1
OPENVEGAS_ENABLE_HOST_IDE_BRIDGE=0
OPENVEGAS_BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ORG_PRICE_ID=
CHECKOUT_SUCCESS_URL=https://app.openvegas.ai/ui/checkout-success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://app.openvegas.ai/ui/checkout-cancel
V_PER_USD=100
STARTER_GRANT_V=100
CASINO_HUMAN_ENABLED=1
INFERENCE_ENABLED=1
AGENT_RUNTIME_ENABLED=1
STORE_ENABLED=1
MINT_AUDIT_ENABLED=1
OPENVEGAS_ENABLE_FILES=1
OPENVEGAS_ENABLE_SPEECH_TO_TEXT=1
OPENVEGAS_ENABLE_CODE_EXEC=0
OPENVEGAS_ENABLE_MCP=0
OPENVEGAS_ENABLE_REALTIME_VOICE=0
OPENVEGAS_ENABLE_IMAGE_GEN=0
OPENAI_API_KEY=
# Optional server-managed customer model routing; register the alias in
# provider_credentials for this runtime environment. Never ship the key to clients.
OPENROUTER_API_KEY=
OPENVEGAS_MODEL_REVIEWS_JSON={}
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
